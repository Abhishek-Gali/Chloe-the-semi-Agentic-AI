# ==============================================================================
# PROJECT CHLOE 2.0 // ENVIRONMENT CONFIGURATION TEMPLATE
# Abhishek's Personal Assistant (Agentic Multimodal AI)
# ==============================================================================

# --- Operating Mode ---
# Options: PARTIALLY_ISOLATED (Fast Hybrid Local), FULLY_ISOLATED (Air-Gapped Local), COMPLETELY_OPEN (Frontier Cloud)
DEFAULT_MODE=PARTIALLY_ISOLATED

# --- Cloud LLM & Audio Providers (Optional for offline mode) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# Model Identifiers
GROQ_LLM_MODEL=qwen/qwen3.8-27b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GEMINI_MODEL=gemini-3.6-flash

# --- Local Air-Gapped Ollama Engine ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=chloe:latest
OLLAMA_MODEL_CODER=qwen2.5-coder:7b
OLLAMA_MODEL_VISION=qwen2.5vl:3b
OLLAMA_MODEL_OFFLINE=qwen2.5:1.5b

# --- Cyber Intelligence MCP APIs (Optional) ---
NVD_API_KEY=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
ALIENVAULT_OTX_KEY=
TAVILY_API_KEY=

# --- Server Binding ---
HOST=0.0.0.0
PORT=8000
DEBUG=False

# --- Audio & Neural TTS ---
DEFAULT_TTS_VOICE=en-US-AriaNeural
TTS_FALLBACK_VOICE=en-GB-SoniaNeural
TTS_RATE=+15%
TTS_PITCH=+0Hz
